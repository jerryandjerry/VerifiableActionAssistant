# The repository runs without an API key. Mock mode is deterministic and free.
VAA_LLM_PROVIDER=mock

# Optional OpenAI Structured Outputs path.
OPENAI_API_KEY=
VAA_OPENAI_MODEL=gpt-5.6

# SQLite works out of the box; PostgreSQL URLs are also accepted.
VAA_DATABASE_URL=sqlite:///./data/vaa.db
VAA_AUTO_SEED=true
VAA_WORKSPACE_RESET_ENABLED=true
VAA_LOG_LEVEL=INFO
